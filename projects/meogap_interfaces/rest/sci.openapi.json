                  "operation": "/internal/v1/catalogue/products/{product_id}"
                }
              }
            }
          },
          "501": {
            "description": "Operation is part of the M0 contract but is not implemented yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "NOT_IMPLEMENTED",
                  "message": "Operation is part of the M0 contract but is not implemented yet.",
                  "service": "sci",
                  "operation": "sci_get_product"
