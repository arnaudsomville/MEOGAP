{
  "openapi": "3.1.0",
  "info": {
    "title": "MEOGAP Scientific Processing (SCI)",
    "version": "0.1.0",
    "description": "Internal scientific processing service."
  },
  "servers": [
    {
      "url": "http://localhost:8002",
      "description": "Local SCI service."
    }
  ],
  "tags": [
    {
      "name": "sci",
      "description": "Internal scientific processing service."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/internal/v1/catalogue/products": {
      "get": {
        "tags": [
          "sci"
        ],
        "summary": "Expose the scientific catalogue.",
        "operationId": "sci_list_products",
        "parameters": [],
        "responses": {
          "401": {
            "description": "A bearer token is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "UNAUTHORIZED",
                  "message": "A bearer token is required.",
                  "service": "sci",
                  "operation": "/internal/v1/catalogue/products"
                }
              }
            }
          },
          "501": {
            "description": "Operation is part of the M0 contract but is not implemented yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "NOT_IMPLEMENTED",
                  "message": "Operation is part of the M0 contract but is not implemented yet.",
                  "service": "sci",
                  "operation": "sci_list_products"
                }
              }
            }
          }
        }
      }
    },
