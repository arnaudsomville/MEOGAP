    "/internal/v1/health": {
      "get": {
        "tags": [
          "sci"
        ],
        "summary": "Report service liveness.",
        "operationId": "sci_health",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "service": "sci",
                  "version": "0.1.0"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token required by every business operation."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "description": "Stable error envelope returned by every failed MEOGAP REST operation.",
        "required": [
          "code",
          "message",
          "service",
          "operation"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable error code."
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message."
          },
          "service": {
            "type": "string",
            "description": "Logical service that produced the error."
          },
          "operation": {
            "type": "string",
            "description": "Operation identifier or request path that failed."
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "description": "Liveness payload exposed by every MEOGAP service.",
        "required": [
          "status",
          "service",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Service status; ok when the process answers."
          },
          "service": {
            "type": "string",
            "description": "Logical service name."
          },
          "version": {
            "type": "string",
            "description": "Service version."
          }
        }
      }
    }
  }
}
