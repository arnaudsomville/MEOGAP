    "/internal/v1/dependencies": {
      "post": {
        "tags": [
          "catalog"
        ],
        "summary": "Resolve abstract requirements to concrete dependencies.",
        "operationId": "catalog_resolve_dependencies",
        "parameters": [],
        "responses": {
          "401": {
            "description": "A bearer token is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "UNAUTHORIZED",
                  "message": "A bearer token is required.",
                  "service": "catalog",
                  "operation": "/internal/v1/dependencies"
                }
              }
            }
          },
          "501": {
            "description": "Operation is part of the M0 contract but is not implemented yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "NOT_IMPLEMENTED",
                  "message": "Operation is part of the M0 contract but is not implemented yet.",
                  "service": "catalog",
                  "operation": "catalog_resolve_dependencies"
                }
              }
            }
          }
        }
      }
    },
