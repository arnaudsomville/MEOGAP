  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token required by every business operation."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "description": "Stable error envelope returned by every failed MEOGAP REST operation.",
        "required": [
          "code",
          "message",
          "service",
          "operation"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable error code."
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message."
          },
          "service": {
            "type": "string",
            "description": "Logical service that produced the error."
          },
          "operation": {
            "type": "string",
            "description": "Operation identifier or request path that failed."
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "description": "Liveness payload exposed by every MEOGAP service.",
        "required": [
          "status",
          "service",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Service status; ok when the process answers."
          },
          "service": {
            "type": "string",
            "description": "Logical service name."
          },
          "version": {
            "type": "string",
            "description": "Service version."
          }
        }
      },
      "AoiGeometry": {
        "type": "object",
        "description": "RFC 7946 GeoJSON Polygon or MultiPolygon in WGS 84 longitude/latitude coordinates.",
        "required": [
          "type",
          "coordinates"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Polygon",
              "MultiPolygon"
            ]
          },
          "coordinates": {
            "type": "array"
          }
        }
      },
      "Aoi": {
        "type": "object",
        "required": [
          "aoi_id",
          "name",
          "geometry",
          "revision",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "aoi_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "geometry": {
            "$ref": "#/components/schemas/AoiGeometry"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AoiListResponse": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Aoi"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AoiCreateRequest": {
        "type": "object",
        "required": [
          "name",
          "geometry"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "geometry": {
            "$ref": "#/components/schemas/AoiGeometry"
          }
        }
      },
      "AoiUpdateRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "geometry": {
            "$ref": "#/components/schemas/AoiGeometry"
          }
        }
      }
    }
  },
  "x-meogap-status": {
    "level": "m0-structural",
    "requestAndSuccessSchemas": "open",
    "openDecisionRefs": [
      "M1-E07-T01",
      "M1-E07-T02"
    ]
  },
  "x-meogap-transport": "provisional-rest-scaffolding"
}
